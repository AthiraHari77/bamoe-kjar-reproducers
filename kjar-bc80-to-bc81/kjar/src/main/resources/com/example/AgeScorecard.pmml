<?xml version="1.0" encoding="UTF-8"?>
<!--
  AgeScorecard.pmml  (PMML 4.4 — BAMOE 8.0 version)
  Input  : age   (double)
  Output : score (double)
  Logic  : age >= 18 → +10 pts, otherwise +0 pts
-->
<PMML version="4.4" xmlns="http://www.dmg.org/PMML-4_4">

  <Header description="Age scorecard — BAMOE 8.0 kjar"/>

  <DataDictionary numberOfFields="2">
    <DataField name="age"   optype="continuous" dataType="double"/>
    <DataField name="score" optype="continuous" dataType="double" usage="predicted"/>
  </DataDictionary>

  <Scorecard modelName="AgeScorecard"
             functionName="regression"
             initialScore="0"
             useReasonCodes="false">

    <MiningSchema>
      <MiningField name="age"   usageType="active"/>
      <MiningField name="score" usageType="predicted"/>
    </MiningSchema>

    <Output>
      <OutputField name="score"
                   optype="continuous"
                   dataType="double"
                   feature="predictedValue"/>
    </Output>

    <Characteristics>
      <Characteristic name="AgeChar">
        <Attribute partialScore="10">
          <SimplePredicate field="age" operator="greaterOrEqual" value="18"/>
        </Attribute>
        <Attribute partialScore="0">
          <True/>
        </Attribute>
      </Characteristic>
    </Characteristics>

  </Scorecard>
</PMML>
