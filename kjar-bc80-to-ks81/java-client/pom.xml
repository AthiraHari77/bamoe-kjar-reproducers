<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Java client for kjar-bc80-to-ks81
    ===================================
    Calls DMN, DRL, BPMN and PMML on a KIE Server 8.1 container that holds
    a KJAR originally authored in Business Central 8.0 (backward-compatible).

    Build   : mvn clean package
    Run DMN : mvn exec:java -Dexec.mainClass=com.example.client.DmnExecute
    Run DRL : mvn exec:java -Dexec.mainClass=com.example.client.DrlExecute
    Run BPMN: mvn exec:java -Dexec.mainClass=com.example.client.BpmnExecute
    Run PMML: mvn exec:java -Dexec.mainClass=com.example.client.PmmlExecute
    Run ALL : mvn exec:java -Dexec.mainClass=com.example.client.RunAll

    Configure via env vars or -D flags:
      KS_URL   (default: http://localhost:8080/kie-server/services/rest/server)
      KS_USER  (default: adminUser)
      KS_PASS  (default: admin@Redhat1)
  -->

  <groupId>com.example</groupId>
  <artifactId>ks-java-client</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Use v8.1 client SDK — it is compatible with v8.0 KJARs on the server -->
    <kie.version>7.81.1-SNAPSHOT</kie.version>
  </properties>

  <repositories>
    <repository>
      <id>kie-local</id>
      <url>file://${env.HOME}/BAMOE-8/BAMOE-8.1/jboss-eap-8.1/repositories/kie/global</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Pin Jackson to match the version bundled with KIE Server 7.81.1-SNAPSHOT -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.17.2</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>2.17.2</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>
    <!-- KIE Server Java SDK -->
    <dependency>
      <groupId>org.kie.server</groupId>
      <artifactId>kie-server-client</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <!-- KIE API (PMMLRequestData, ParameterInfo, KieCommands) -->
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-api</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <!-- Drools core (ApplyPmmlModelCommand) -->
    <dependency>
      <groupId>org.drools</groupId>
      <artifactId>drools-core</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <!-- DMN evaluation support -->
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-dmn-core</artifactId>
      <version>${kie.version}</version>
    </dependency>
    <!--
      The KJAR itself — puts Applicant.class on the classpath so the
      Java client can instantiate it for DRL batch execution.
      Built with KIE 7.67.2 but the class is identical.
    -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>example-kjar</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
      </plugin>
    </plugins>
  </build>

</project>
