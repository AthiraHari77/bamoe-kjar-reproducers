<?xml version="1.0" encoding="UTF-8"?>
<!--
  kmodule.xml — KIE module descriptor (Business Central 8.1 format)

  default="true" on <kbase> is required so the KIE Server DMN REST endpoint
  (/containers/{id}/dmn) can resolve the model through the default KieBase.
  Without it KIE Server returns "Cannot find a default KieBase".
-->
<kmodule xmlns="http://www.drools.org/xsd/kmodule">
  <kbase name="defaultKieBase" default="true" packages="com.example">
    <ksession name="defaultKieSession"  type="stateful"  default="true"/>
    <ksession name="defaultStatelessKieSession" type="stateless"/>
  </kbase>
</kmodule>
