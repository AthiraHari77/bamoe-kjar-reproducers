<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    KJAR for Scenario 1
    ===================
    groupId    : com.example
    artifactId : example-kjar
    version    : 1.0.0

    packaging=kjar  → kie-maven-plugin validates + compiles all assets.
    Built with JDK 17 / BAMOE 8.1 (KIE 7.81.1-SNAPSHOT).

    Build command:
      mvn clean install

    Output:
      target/example-kjar-1.0.0.jar   ← the KJAR to push to BC / upload
  -->

  <groupId>com.example</groupId>
  <artifactId>example-kjar</artifactId>
  <version>1.0.0</version>
  <packaging>kjar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kie.version>7.81.1-SNAPSHOT</kie.version>
  </properties>

  <!-- Resolve KIE artifacts from the EAP 8.1 embedded Maven repository. -->
  <repositories>
    <repository>
      <id>kie-local</id>
      <url>file://${env.HOME}/BAMOE-8/BAMOE-8.1/jboss-eap-8.1/repositories/kie/global</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>kie-local-plugins</id>
      <url>file://${env.HOME}/BAMOE-8/BAMOE-8.1/jboss-eap-8.1/repositories/kie/global</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencies>
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-api</artifactId>
      <version>${kie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-internal</artifactId>
      <version>${kie.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        kie-maven-plugin MUST have <extensions>true</extensions>.
        This registers the kjar packaging lifecycle:
          validate → compile → package
        It also validates every DMN, DRL, BPMN, PMML file at compile time.
      -->
      <plugin>
        <groupId>org.kie</groupId>
        <artifactId>kie-maven-plugin</artifactId>
        <version>${kie.version}</version>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>

</project>
