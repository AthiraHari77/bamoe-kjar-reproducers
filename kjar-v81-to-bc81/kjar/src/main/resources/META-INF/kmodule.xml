<?xml version="1.0" encoding="UTF-8"?>
<!--
  kmodule.xml — MANDATORY in every KJAR.
  Lives at:  src/main/resources/META-INF/kmodule.xml

  Declares one KieBase called "defaultKieBase" that scans the whole
  resources tree.  The defaultStatelessKieSession name must match
  what you use in KIE Server curl/Java calls.
-->
<kmodule xmlns="http://www.drools.org/xsd/kmodule">
  <kbase name="defaultKieBase" packages="com.example" default="true">
    <ksession name="defaultStatelessKieSession" type="stateless" default="true"/>
    <ksession name="defaultKieSession" type="stateful"/>
  </kbase>
</kmodule>
